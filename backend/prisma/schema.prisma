generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ConversationType {
  DIRECT
  CHANNEL
}

enum Role {
  HERMANO
  INQUISIDOR
  ARZOBISPO
}

enum Gender {
  MASCULINO
  FEMENINO
}

// Modelo de usuario: datos base de autenticación y perfil
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  // Optional now — accounts created via 42 OAuth never set a password;
  // they can only log in by going through 42 again. login() checks for
  // a null passwordHash explicitly and rejects cleanly, instead of
  // handing bcrypt.compare a null value.
  passwordHash String?
  // Links this account to a specific 42 intranet user id, used to
  // recognize a returning OAuth login — null for anyone who registered
  // the normal way and never connected their 42 account.
  intraId      Int?     @unique
  displayName  String?  @unique
  avatarUrl    String?
  role         Role     @default(HERMANO)
  // Used only to pick the grammatically correct (masculine/feminine) form
  // of the role name when displaying it — the role's actual permissions
  // never depend on this
  gender       Gender   @default(MASCULINO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  conversations ConversationParticipant[]
  messages         Message[] @relation("MessageSender")
  deletedMessages  Message[] @relation("MessageDeletedBy")
  notifications Notification[]
  articles      Article[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Conversation {
  id        Int              @id @default(autoincrement())
  type      ConversationType
  name      String?
  createdAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  attachmentFilename String?
  attachmentType     String?
  attachmentName     String?
  createdAt      DateTime @default(now())

  deletedAt   DateTime?
  deletedById Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  deletedBy    User?        @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  params    Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityEvent {
  id            Int      @id @default(autoincrement())
  type          String
  templateIndex Int?
  params        Json?
  createdAt     DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
