generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Modelo de usuario: datos base de autenticación y perfil
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   // Nunca guardamos la contraseña en texto plano, solo el hash
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  // A user can appear on either side of a friendship: as the one who sent
  // the request, or as the one who received it. Two separate relation
  // names are required because both point to the same User model.
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
}

// Guardamos los refresh tokens en la base de datos para poder revocarlos
// individualmente (logout de una sola sesión, no de todas)
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // Prevents sending a duplicate request to the same person twice
  @@unique([requesterId, addresseeId])
}
