generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ConversationType {
  DIRECT
  CHANNEL
}

enum Role {
  HERMANO
  INQUISIDOR
  ARZOBISPO
}

enum Gender {
  MASCULINO
  FEMENINO
}

// Modelo de usuario: datos base de autenticación y perfil
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  role         Role     @default(HERMANO)
  // Used only to pick the grammatically correct (masculine/feminine) form
  // of the role name when displaying it — the role's actual permissions
  // never depend on this
  gender       Gender   @default(MASCULINO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  conversations ConversationParticipant[]
  messages         Message[] @relation("MessageSender")
  deletedMessages  Message[] @relation("MessageDeletedBy")
  notifications Notification[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

// A conversation is either a DIRECT chat (exactly 2 participants) or a
// CHANNEL (many participants, e.g. the general chat everyone joins).
// Both share the same message history model below.
model Conversation {
  id        Int              @id @default(autoincrement())
  type      ConversationType
  name      String?          // only meaningful for CHANNEL type
  createdAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

// Join table: which users belong to which conversation
model ConversationParticipant {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  // Attachment fields — all optional, since most messages have no file.
  // attachmentFilename is the name on disk (used to look the file up when
  // serving it); attachmentName is the ORIGINAL filename, kept separately
  // for display purposes (users see their real filename, not a UUID).
  attachmentFilename String?
  attachmentType     String?
  attachmentName     String?
  createdAt      DateTime @default(now())

  // Soft delete: a "deleted" message is NOT removed from the database —
  // its content stays hidden and a tombstone ("Herejía eliminada por...")
  // is shown instead, permanently, to everyone. deletedById uses SetNull
  // (not Cascade) so the tombstone survives even if the moderator who
  // deleted it later has their own account removed.
  deletedAt   DateTime?
  deletedById Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  deletedBy    User?        @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

// Personal, targeted notification — belongs to exactly one user, has a
// read/unread state. This is the "inbox" half of the system.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Public, community-wide chronicle entry — no owner, no read state. Some
// of these mirror real actions (a new adept joined, a rank changed), some
// are purely flavorful/fictional filler for atmosphere.
model CommunityEvent {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  createdAt DateTime @default(now())
}
