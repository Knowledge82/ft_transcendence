generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ConversationType {
  DIRECT
  CHANNEL
}

enum Role {
  HERMANO
  INQUISIDOR
  ARZOBISPO
}

enum Gender {
  MASCULINO
  FEMENINO
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  intraId      Int?     @unique
  displayName  String?  @unique
  avatarUrl    String?
  role         Role     @default(HERMANO)
  gender       Gender   @default(MASCULINO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  conversations ConversationParticipant[]
  messages         Message[] @relation("MessageSender")
  deletedMessages  Message[] @relation("MessageDeletedBy")
  notifications Notification[]
  articles      Article[]

  // A user belongs to at most ONE faction at a time — enforced here at
  // the database level by making userId unique on OrganizationMember,
  // not just checked in application code
  organizationMembership OrganizationMember?
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Conversation {
  id        Int              @id @default(autoincrement())
  type      ConversationType
  name      String?
  createdAt DateTime         @default(now())

  // Set only for a faction's own dedicated channel — @unique because a
  // faction has exactly one channel, never more than one
  organizationId Int?          @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  attachmentFilename String?
  attachmentType     String?
  attachmentName     String?
  createdAt      DateTime @default(now())

  deletedAt   DateTime?
  deletedById Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  deletedBy    User?        @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  params    Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityEvent {
  id            Int      @id @default(autoincrement())
  type          String
  templateIndex Int?
  params        Json?
  createdAt     DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  createdAt DateTime @default(now())

  // null = a normal public library article (current behavior, unchanged).
  // Set = visible only to members of that faction — an "internal"
  // treatise, the same infrastructure just scoped differently.
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// A faction within the church — Radical, Snob, etc. Only an ARZOBISPO
// can create one; editing/deleting is allowed for a current ARZOBISPO
// OR whoever is this specific faction's own leader, regardless of that
// person's current global rank (so a demoted founder still keeps the
// ability to dissolve the faction they created).
model Organization {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  manifesto String?
  // Hex color used for the small badge shown next to a member's name
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  conversation Conversation?
  articles     Article[]
}

// Join table for faction membership — userId is @unique (not a
// composite key with organizationId) specifically to enforce "at most
// one faction per person" at the database level.
model OrganizationMember {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int      @unique
  // Faction-scoped leadership — deliberately separate from the global
  // Role enum. This is what lets a demoted ARZOBISPO retain control
  // over a faction they founded.
  isLeader       Boolean  @default(false)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}
